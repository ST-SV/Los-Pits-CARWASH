// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id              String    @id @default(cuid())
  adminPinHash    String    // bcrypt hash of admin PIN
  devicePassword  String    // bcrypt hash of device session password
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([id])
}

model Empleado {
  id                  String    @id @default(cuid())
  nombre              String
  apellido            String?
  role                String    // "recepcion" | "lavador" | "extra" | "socio"
  pinHash             String?   // bcrypt hash, null if no PIN
  dui                 String?
  tipoDocumento       String?   // "DUI" | "PASAPORTE" | "RESIDENTE" (socios)
  numeroDocumento     String?   // numero de documento (socios)
  email               String?
  telefono            String?
  emergenciaName      String?
  emergenciaTelefono  String?
  horario             String?
  sueldoQuincenal     Float     @default(0)
  sueldoMensual       Float     @default(0)
  comisionPercent     Float     @default(5)
  comisionThreshold   Float     @default(12)
  metaAutosMensual    Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ventasAsCajero      Venta[]   @relation("CajeroVentas")
  itemsAsLavador      VentaItem[] @relation("LavadorItems")
  gastosRegistrados   Gasto[]   @relation("GastoRegistrador")
  auditLogs           AuditLog[] @relation("AuditActor")
  turnos              Turno[]   @relation("EmpleadoTurnos")
  descuentos          Descuento[] @relation("EmpleadoDescuentos")
  recibos             ReciboFirma[] @relation("EmpleadoRecibos")
  nominaPagos         NominaPago[] @relation("EmpleadoNominaPagos")
}

model ReciboFirma {
  id          String    @id @default(cuid())
  empleadoId  String
  empleado    Empleado  @relation("EmpleadoRecibos", fields: [empleadoId], references: [id], onDelete: Cascade)
  periodoKey  String    // "2026-08-Q1" | "2026-08-Q2" | "2026-08-M"
  token       String    @unique
  firmaNombre String?
  firmaFecha  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([empleadoId, periodoKey])
  @@index([token])
}

model Turno {
  id          String    @id @default(cuid())
  empleadoId  String
  empleado    Empleado  @relation("EmpleadoTurnos", fields: [empleadoId], references: [id], onDelete: Cascade)
  diaSemana   Int       // 0=Lunes ... 6=Domingo
  horaInicio  String    // "07:00"
  horaFin     String    // "13:00"
  createdAt   DateTime  @default(now())

  @@index([empleadoId])
  @@index([diaSemana])
}

model Descuento {
  id          String    @id @default(cuid())
  empleadoId  String
  empleado    Empleado  @relation("EmpleadoDescuentos", fields: [empleadoId], references: [id], onDelete: Cascade)
  periodo     String    // "2026-08-Q1" | "2026-08-Q2" | "2026-08-M"
  monto       Float
  motivo      String
  createdAt   DateTime  @default(now())

  @@index([empleadoId])
  @@index([periodo])
}

model HorarioNegocio {
  id            String   @id @default(cuid())
  diaSemana     Int      @unique // 0=Lunes ... 6=Domingo
  abierto       Boolean  @default(true)
  horaApertura  String?  // "07:00"
  horaCierre    String?  // "18:00"
  updatedAt     DateTime @updatedAt
}

model Socio {
  id        String    @id @default(cuid())
  numero    Int       @unique  // Correlativo
  nombre    String
  apellido  String?
  email     String?
  telefono  String?
  contacto  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  autos     AutoSocio[]
  ventas    Venta[]   @relation("VentaSocio")
  cuentas   CuentaAbierta[] @relation("CuentaSocio")
}

// Dueño = socio-inversionista del negocio (distinto de "Socio", que son los
// clientes/miembros del carwash). Libro de capital: aportes, retiros,
// préstamos y utilidad distribuida, independiente de la contabilidad operativa.
model Dueno {
  id        String    @id @default(cuid())
  nombre    String
  apellido  String?
  porcentajeParticipacion Float @default(0)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  movimientos DuenoMovimiento[]
}

model DuenoMovimiento {
  id            String   @id @default(cuid())
  duenoId       String
  dueno         Dueno    @relation(fields: [duenoId], references: [id], onDelete: Cascade)
  tipo          String   // "aporte" | "retiro" | "prestamo" | "utilidad" (utilidad pagada al dueño)
  monto         Float
  fecha         DateTime @default(now())
  motivo        String?
  registradoPor String?
  createdAt     DateTime @default(now())

  @@index([duenoId])
  @@index([tipo])
  @@index([fecha])
}

model AutoSocio {
  id      String  @id @default(cuid())
  socioId String
  modelo  String

  socio   Socio   @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId])
}

model CatalogoServicio {
  id    String  @id @default(cuid())
  nombre String  @unique
  precio Float
  categoria String @default("General") // "SEDÁN" | "CAMIONETA PEQUEÑA" | "CAMIONETA MEDIANA" | "CAMIONETA GRANDE" | "PICK UP" | "PICK UP XL" | "General"

  items   VentaItem[]  @relation("ServicioItems")

  @@index([nombre])
  @@index([categoria])
}

model CatalogoProducto {
  id    String  @id @default(cuid())
  nombre String  @unique
  precio Float
  categoria String @default("Otros") // "Bebidas Frías" | "Bebidas Calientes" | "Snacks" | "Otros"
  stock  Int?    // null = sin control de stock; número = unidades disponibles

  items   VentaItem[]  @relation("ProductoItems")

  @@index([nombre])
  @@index([categoria])
}

model Venta {
  id                  String    @id @default(cuid())
  fecha               DateTime  @default(now())
  items               VentaItem[]
  total               Float
  descuentoMonto      Float     @default(0)
  descuentoMotivo     String?
  metodoPago          String    // "efectivo" | "tarjeta" | "transferencia"
  numeroRecibo        String
  referencia          String?   // numero de transferencia
  montoRecibido       Float?    // efectivo: monto con el que paga el cliente
  vuelto              Float?    // efectivo: cambio a devolver
  banco               String?   // tarjeta: banco emisor
  numeroCupon         String?   // tarjeta: numero de cupon del posnet
  comprobanteFoto     String?   // transferencia: foto del comprobante (base64)
  cajeroId            String
  cajero              Empleado  @relation("CajeroVentas", fields: [cajeroId], references: [id])
  socioId             String?
  socio               Socio?    @relation("VentaSocio", fields: [socioId], references: [id], onDelete: SetNull)
  anulada             Boolean   @default(false)
  anuladaPor          String?
  anuladaMotivo       String?
  anuladaTime         DateTime?
  ultimoMotivoEdicion String?   // Last reason if edited in admin
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([cajeroId])
  @@index([socioId])
  @@index([fecha])
}

model VentaItem {
  id            String  @id @default(cuid())
  ventaId       String
  venta         Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  nombre        String
  precio        Float
  cantidad      Int
  categoria     String  // "servicio" | "producto"

  lavadorId     String?
  lavador       Empleado? @relation("LavadorItems", fields: [lavadorId], references: [id], onDelete: SetNull)

  servicioId    String?
  servicio      CatalogoServicio? @relation("ServicioItems", fields: [servicioId], references: [id], onDelete: SetNull)

  productoId    String?
  producto      CatalogoProducto? @relation("ProductoItems", fields: [productoId], references: [id], onDelete: SetNull)

  @@index([ventaId])
  @@index([lavadorId])
}

model Gasto {
  id              String    @id @default(cuid())
  descripcion     String
  monto           Float
  fecha           DateTime  @default(now())
  categoria       String    // "nomina" | "otro"
  registradoPor   String?   // name of employee who registered
  registradoPorId String?
  registrador     Empleado? @relation("GastoRegistrador", fields: [registradoPorId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  estado          String    @default("pagado") // "pendiente" | "pagado" — default preserva el comportamiento histórico
  fechaPago       DateTime? // cuando se marcó como pagado (si aplica)
  gastoFijoId     String?   // si este gasto es el pago real de un GastoFijo
  gastoFijo       GastoFijo? @relation(fields: [gastoFijoId], references: [id], onDelete: SetNull)
  nominaPagoId    String?   @unique // si este gasto es el registro de un NominaPago
  nominaPago      NominaPago? @relation(fields: [nominaPagoId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([categoria])
  @@index([estado])
  @@index([gastoFijoId])
}

model GastoFijo {
  id          String   @id @default(cuid())
  descripcion String
  monto       Float
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pagos       Gasto[]
}

model NominaPago {
  id            String   @id @default(cuid())
  empleadoId    String
  empleado      Empleado @relation("EmpleadoNominaPagos", fields: [empleadoId], references: [id], onDelete: Cascade)
  periodoKey    String   // "2026-08-Q1" | "2026-08-Q2" | "2026-08-M"
  monto         Float
  fechaPago     DateTime @default(now())
  pagadoPor     String?
  pagadoPorId   String?
  createdAt     DateTime @default(now())
  gasto         Gasto?

  @@index([empleadoId])
  @@index([periodoKey])
}

model CuentaAbierta {
  id          String  @id @default(cuid())
  etiqueta    String  // "Toyota gris - Juan" or similar
  items       CuentaAbiertaItem[]
  socioId     String?
  socio       Socio?  @relation("CuentaSocio", fields: [socioId], references: [id], onDelete: SetNull)
  fechaApertura DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([socioId])
}

model CuentaAbiertaItem {
  id        String  @id @default(cuid())
  cuentaId  String
  cuenta    CuentaAbierta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  nombre    String
  precio    Float
  cantidad  Int
  categoria String  // "servicio" | "producto"
  lavadorId String?
  lavadorNombre String?

  @@index([cuentaId])
}

model CierreDeCaja {
  id              String  @id @default(cuid())
  fecha           DateTime
  totalVentas     Float
  totalGastos     Float
  neto            Float
  ventasCount     Int
  byPayEffectivo  Float   @default(0)
  byPayTarjeta    Float   @default(0)
  byPayTransferencia Float @default(0)
  cerradoPor      String  // name of who closed
  createdAt       DateTime @default(now())

  @@index([fecha])
}

model AuditLog {
  id      String    @id @default(cuid())
  fecha   DateTime  @default(now())
  actor   String    // name real
  accion  String
  detalle String?
  actorId String?
  actorEmp Empleado? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([accion])
}
